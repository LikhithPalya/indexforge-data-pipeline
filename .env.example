# =============================================================================
# IndexForge Data Pipeline - Environment Configuration
# =============================================================================

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/indexforge
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Wikipedia Enrichment
WIKIPEDIA_API_BASE_URL=https://en.wikipedia.org/api/rest_v1
WIKIPEDIA_REQUEST_TIMEOUT=30
WIKIPEDIA_RATE_LIMIT_DELAY=1.0

# Embedding Model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=384

# Pipeline Configuration
PIPELINE_BATCH_SIZE=100
PIPELINE_MAX_RETRIES=3
PIPELINE_RETRY_DELAY=5

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Data Paths
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
ENRICHED_DATA_DIR=data/enriched